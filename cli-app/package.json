{
  "name": "clearspec",
  "version": "0.1.0",
  "description": "Connects the clearspec web app to the coding agents on your computer (Claude Code, Codex, GitHub Copilot CLI, Cursor Agent, any ACP agent). Run: npx clearspec connect",
  "keywords": ["requirements", "spec", "claude-code", "codex", "copilot", "cursor", "acp", "agent"],
  "type": "module",
  "bin": {
    "clearspec": "bin/clearspec.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "prepack": "npm run sync-skill && npm run check-pack"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  }
}
